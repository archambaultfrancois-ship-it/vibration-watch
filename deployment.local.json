{
  "version": 1,
  "components": {
    "sensor_1": {
      "container": {
        "language": "c",
        "handler": "components/sensor/handler.c"
      }
    },
    "analyzer_1": {
      "container": {
        "language": "rust",
        "handler": "components/analyzer/handler.rs"
      }
    },
    "sensor_2": {
      "container": {
        "language": "c",
        "handler": "components/sensor/handler.c"
      }
    },
    "analyzer_2": {
      "container": {
        "language": "rust",
        "handler": "components/analyzer/handler.rs"
      }
    },
    "alarm": {
      "container": {
        "language": "python",
        "handler": "components/alarm/handler.py"
      }
    },
    "observer": {
      "container": {
        "language": "python",
        "handler": "components/observer/handler.py"
      }
    }
  },
  "parameter_clients": {
    "operator": {
      "read": [
        "machines/1/detection",
        "machines/2/detection",
        "machines/1/sensor",
        "machines/2/sensor"
      ],
      "write": [
        "machines/1/detection",
        "machines/2/detection",
        "machines/1/sensor",
        "machines/2/sensor"
      ],
      "token": "vibration-watch-local-operator"
    }
  }
}
